# Copier ce fichier en .env et remplir les valeurs.
# Ce fichier .env.example est le SEUL fichier de configuration versionné :
# aucune valeur réelle ni secret ne doit se trouver dans le dépôt (voir R-08 / F1).

# Port d'écoute HTTP de l'API
PORT=3000

# Chaîne de connexion MongoDB Atlas (palier gratuit)
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/pilulier?retryWrites=true&w=majority

# Clé utilisée pour signer les jetons d'authentification (JWT).
# Générer une valeur aléatoire longue, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-deploying

# Durée de validité d'un jeton
JWT_EXPIRES_IN=7d

# Origine(s) autorisée(s) à appeler l'API (CORS). "*" en développement local.
CORS_ORIGIN=*
