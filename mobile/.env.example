# Copier en .env. Expo n'expose au bundle que les variables préfixées
# EXPO_PUBLIC_ (voir src/api/client.js).

# En développement local (téléphone et ordinateur sur le même réseau Wi-Fi) :
# remplacer par l'adresse IP locale de l'ordinateur, ex. http://192.168.1.23:3000/api
# En pointant sur l'API déployée (Render) :
EXPO_PUBLIC_API_URL=http://localhost:3000/api
